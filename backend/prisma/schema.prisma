generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================
// Identity context
// ==========================

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  passwordHash      String
  avatarUrl         String?
  showLastSeen      Boolean  @default(true) // "visto por último" é público por padrão
  readReceiptsEnabled Boolean @default(true) // double-check azul, opcional por usuário
  lastSeenAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  participations    ConversationParticipant[]
  sentMessages      Message[]                 @relation("MessageSender")
  messageReads      MessageRead[]
  messageDeletions  MessageDeletion[]
  uploadedMedia     MediaAsset[]

  @@map("users")
}

// ==========================
// Messaging context
// ==========================

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id            String            @id @default(uuid())
  type          ConversationType
  name          String? // apenas para GROUP
  avatarUrl     String? // apenas para GROUP

  // Apenas para DIRECT: quem iniciou o contato e se o outro lado já "aceitou"
  // (aceite = respondeu ou abriu a conversa). Enquanto acceptedAt for null,
  // o destinatário vê a conversa como "Fulano quer falar com você".
  initiatorId   String?
  acceptedAt    DateTime?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  participants  ConversationParticipant[]
  messages      Message[]
  gameSessions  GameSession[]

  @@map("conversations")
}

enum ParticipantRole {
  MEMBER
  ADMIN
}

model ConversationParticipant {
  id              String          @id @default(uuid())
  conversationId  String
  conversation    Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  role            ParticipantRole @default(MEMBER)
  joinedAt        DateTime        @default(now())
  leftAt          DateTime? // null = ainda está no grupo/conversa
  removedByUserId String?    // preenchido quando foi removido por um admin (não saiu por conta própria)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

enum MessageType {
  TEXT
  SYSTEM
  MEDIA
  GAME_INVITE
}

// ==========================
// Games context
// ==========================

enum GameType {
  TIC_TAC_TOE
}

enum GameStatus {
  PENDING       // convite enviado, aguardando aceite
  IN_PROGRESS
  FINISHED
  DECLINED
}

model GameSession {
  id                String      @id @default(uuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type              GameType    @default(TIC_TAC_TOE)
  status            GameStatus  @default(PENDING)

  // Sem relação FK pra User de propósito - mesma convenção usada em
  // Conversation.initiatorId: a validação de que são participantes válidos da
  // conversa é regra de domínio, não integridade referencial de banco.
  invitedByUserId   String
  playerXId         String
  playerOId         String
  currentTurnUserId String?
  winnerUserId      String?

  board             String      @default("_________") // 9 posições: X, O ou _
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  messages          Message[]

  @@map("game_sessions")
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
}

// ==========================
// Media context
// ==========================

model MediaAsset {
  id          String    @id @default(uuid())
  uploaderId  String
  uploader    User      @relation(fields: [uploaderId], references: [id])
  kind        MediaKind
  mimeType    String
  sizeBytes   Int
  fileName    String
  storageKey  String    @unique // caminho/objeto no bucket MinIO - a URL é sempre gerada sob demanda (presigned)
  createdAt   DateTime  @default(now())

  messages    Message[]

  @@map("media_assets")
}

enum SystemMessageEvent {
  PARTICIPANT_JOINED
  PARTICIPANT_LEFT
  PARTICIPANT_REMOVED
  GROUP_CREATED
  GROUP_RENAMED
  GROUP_AVATAR_CHANGED
  ADMIN_PROMOTED
  ADMIN_DEMOTED
}

model Message {
  id                   String        @id @default(uuid())
  conversationId       String
  conversation         Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId             String?       // null para mensagens de sistema
  sender               User?         @relation("MessageSender", fields: [senderId], references: [id])
  type                 MessageType   @default(TEXT)
  systemEvent          SystemMessageEvent?
  content              String?       // texto da mensagem (TEXT) ou legenda opcional (MEDIA)
  mediaAssetId         String?       // preenchido quando type = MEDIA
  mediaAsset           MediaAsset?   @relation(fields: [mediaAssetId], references: [id])
  gameSessionId        String?       // preenchido quando type = GAME_INVITE
  gameSession          GameSession?  @relation(fields: [gameSessionId], references: [id])
  editedAt             DateTime?     // preenchido quando a mensagem foi editada
  deletedForEveryoneAt DateTime?     // "apagar para todos" - sem prazo, então só verificamos se está preenchido
  createdAt            DateTime      @default(now())

  reads                MessageRead[]
  deletions            MessageDeletion[] // "apagar para mim" (por usuário)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Confirmação de leitura (double-check azul) - opcional por usuário (readReceiptsEnabled)
model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@map("message_reads")
}

// "Apagar para mim" - a mensagem some só para quem apagou, sem prazo
model MessageDeletion {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  deletedAt DateTime @default(now())

  @@unique([messageId, userId])
  @@map("message_deletions")
}
